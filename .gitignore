# Byte-compiled / caches
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Test / tooling artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Experiment outputs: working dirs are ignored; VALIDATED run archives are
# explicitly committed as the research record (user directive: everything public).
runs/*
!runs/.gitkeep
# Owner directive 2026-10-20 (commit 5d1a00e): all data recorded on cores
# before v0.6.0 is renamed to pre-tests-data; the v0.6.0 program restarts
# every phase from scratch. Pre-test evidence stays public under this prefix.
!runs/pre-tests-data/
# New-core run archives (whitelisted as they land):
!runs/v6/
data/generated/
artifacts/
# Research-run integrity manifests are evidence, not build artifacts:
# the per-file SHA-256 manifest IS the checksum coverage the release
# contract promises (2026-10-20 reproducibility-audit condition).
!runs/**/artifacts/

# Secrets — never commit
# NOTE: never use broad patterns like *KAGGLE* here — it silently excluded
# docs/SOP_002_KAGGLE_OPERATIONS.md and docs/blueprint/03_KAGGLE_RUNBOOK.md
# from version control. Match secret filenames precisely instead.
.secrets/
*.token
KAGGLE_API_TOKEN*
KAGGLE_TOKEN*
kaggle.json
access_token
.env

# OS / editor
.DS_Store
.idea/
.vscode/

# Large model caches
models_cache/
