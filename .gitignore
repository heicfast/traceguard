# Byte-compiled / caches
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Test / tooling artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Experiment outputs: working dirs are ignored; VALIDATED run archives are
# explicitly committed as the research record (user directive: everything public).
runs/*
!runs/.gitkeep
!runs/gpu_smoke_v1/
!runs/gpu_smoke_v3/
!runs/gpu_smoke_v4/
!runs/pilot/
data/generated/
artifacts/

# Secrets — never commit
.secrets/
*.token
*KAGGLE*
kaggle.json
access_token
.env

# OS / editor
.DS_Store
.idea/
.vscode/

# Large model caches
models_cache/
