# Byte-compiled / caches
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Test / tooling artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Experiment outputs: working dirs are ignored; VALIDATED run archives are
# explicitly committed as the research record (user directive: everything public).
runs/*
!runs/.gitkeep
!runs/gpu_smoke_v1/
!runs/gpu_smoke_v3/
!runs/gpu_smoke_v4/
!runs/pilot/
data/generated/
artifacts/

# Secrets — never commit
# NOTE: never use broad patterns like *KAGGLE* here — it silently excluded
# docs/SOP_002_KAGGLE_OPERATIONS.md and docs/blueprint/03_KAGGLE_RUNBOOK.md
# from version control. Match secret filenames precisely instead.
.secrets/
*.token
KAGGLE_API_TOKEN*
KAGGLE_TOKEN*
kaggle.json
access_token
.env

# OS / editor
.DS_Store
.idea/
.vscode/

# Large model caches
models_cache/
